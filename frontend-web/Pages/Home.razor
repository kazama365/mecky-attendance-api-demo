    private async Task ApproveUserAsync(UserAccountRecord account)
    {
        if (busy || account.active || string.IsNullOrWhiteSpace(account.employeeId)) return;
        busy = true;
        errorMessage = "";
        try
        {
            using var response = await Http.PutAsJsonAsync($"api/users/{account.id}", new
            {
                username = account.username,
                role = "EMPLOYEE",
                employeeId = account.employeeId,
                active = true,
                password = (string?)null
            });
            if (!response.IsSuccessStatusCode) { errorMessage = await ReadServerErrorAsync(response); return; }
            await LoadUsersAsync();
        }
        catch (HttpRequestException) { errorMessage = "The account could not be approved. Check the server connection and try again."; }
        finally { busy = false; }
    }

