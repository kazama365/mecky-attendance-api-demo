    private void CancelDeactivation() => employeeToDeactivate = null;

    private async Task DeactivateEmployeeAsync()
    {
        if (busy || employeeToDeactivate is not { } employee) return;
        busy = true;
        errorMessage = "";
        try
        {
            using var response = await Http.DeleteAsync($"api/employees/{Uri.EscapeDataString(employee.employeeId)}");
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ReadServerErrorAsync(response);
                return;
            }
            employees.RemoveAll(record => record.employeeId == employee.employeeId);
            CancelDeactivation();
            employeeNotice = $"{employee.fullName} was deactivated.";
        }
        catch (HttpRequestException) { errorMessage = "Could not confirm deactivation. Refresh the list and check the employee status."; }
        finally { busy = false; }
    }

    private async Task CreateEmployeeAsync()
    {
        if (busy) return;
        busy = true;
        errorMessage = "";
        var id = newEmployeeId.Trim();
        try
        {
            using var response = await Http.PostAsJsonAsync("api/employees", new
            {
                employeeId = id,
                fullName = newEmployeeName.Trim(),
                position = newEmployeePosition.Trim(),
                dailyRate = newEmployeeRate
            });
            if (!response.IsSuccessStatusCode) { errorMessage = await ReadServerErrorAsync(response); return; }
            CloseEmployeeForm();
            employeeNotice = $"Employee {id} saved. Share this ID for signup, or select Start enrollment to link a fingerprint.";
            await LoadEmployeesAsync();
        }
        catch (HttpRequestException) { errorMessage = "Could not save the employee. Refresh the list before trying again."; }
        finally { busy = false; }
    }

