    private static async Task<string> ReadServerErrorAsync(HttpResponseMessage response)
    {
        var body = await response.Content.ReadAsStringAsync();
        try
        {
            using var json = System.Text.Json.JsonDocument.Parse(body);
            if (json.RootElement.TryGetProperty("error", out var error)) return error.GetString() ?? "The request could not be completed.";
            if (json.RootElement.TryGetProperty("message", out var message)) return message.GetString() ?? "The request could not be completed.";
        }
        catch { }
        return response.StatusCode == System.Net.HttpStatusCode.TooManyRequests ? "Too many attempts. Wait 10 minutes, then try again."  : $"The server could not complete the request (HTTP {(int)response.StatusCode}).";
    }

    private void SignOut()
    {
        Http.DefaultRequestHeaders.Authorization = null;
        isSignedIn = false; isWorker = false; showSignup = false; username = ""; password = ""; signupEmployeeId = ""; signupUsername = ""; signupPassword = ""; signupConfirmPassword = ""; signupMessage = ""; errorMessage = "";
        CloseEmployeeForm();
        CancelDeactivation();
        employeeNotice = "";
        worker = null; workerAttendance = null; dashboard = null; payrollRows = null; payrollSaved = false; connectedDevice = null; enrollmentMessages.Clear(); employees.Clear(); users.Clear(); attendanceRows.Clear();
    }

