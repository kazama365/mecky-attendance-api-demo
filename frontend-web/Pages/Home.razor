@page "/"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Mecky's Attendance</PageTitle>

@if (!isSignedIn)
{
    <main class="login-screen">
        <section class="login-card">
            <div class="login-brand">
                <div class="brand-mark">M</div>
                <p class="eyebrow">MECKY'S CONSUMER ELECTRONICS</p>
                <h1>Attendance, made simple.</h1>
                <p class="brand-copy">A clear view of every shift, scan, and workday in one place.</p>
                <div class="login-feature"><span>01</span><div><strong>One attendance record</strong><small>Fingerprint scans appear in the same system.</small></div></div>
                <div class="login-feature"><span>02</span><div><strong>Admin and worker access</strong><small>Each account sees the information meant for them.</small></div></div>
                <div class="brand-footer">MECKY ATTENDANCE SYSTEM <span>•</span> DEMO</div>
            </div>
            <div class="login-form-panel">
                <div class="mobile-brand"><div class="brand-mark">M</div><span>MECKY'S</span></div>
                <p class="eyebrow green">@(showSignup ? "WORKER REGISTRATION" : "WELCOME BACK")</p>
                <h2>@(showSignup ? "Create a worker account" : "Sign in to your account")</h2>
                <p class="muted">@(showSignup ? "Use the Employee ID given by the Admin. Your account needs approval before sign-in." : "Use your admin or worker account to continue.")</p>
                @if (!showSignup)
                {
                    <form class="login-form" @onsubmit="LoginAsync" @onsubmit:preventDefault="true">
                        <label for="username">Username</label>
                        <input id="username" autocomplete="username" @bind="username" placeholder="Enter your username" required />
                        <label for="password">Password</label>
                        <input id="password" type="password" autocomplete="current-password" @bind="password" placeholder="Enter your password" required />
                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert error" role="alert">@errorMessage</div>
                        }
                        <button class="button primary full" type="submit" disabled="@busy">@(busy ? "Signing in…" : "Sign in") <span aria-hidden="true">→</span></button>
                    </form>
                    <div class="signup-callout">
                        <div><strong>New worker?</strong><small>Get your Employee ID from the admin to request access.</small></div>
                        <button class="button outline" type="button" @onclick="ShowSignup">Sign up</button>
                    </div>
                    <div class="demo-box">
                    <div><strong>Demo accounts</strong><small>These accounts work on the demo server only.</small></div>
                    <button class="demo-choice" type="button" @onclick="UseAdminDemo"><span>Admin</span><b>Fill details</b></button>
                    <button class="demo-choice" type="button" @onclick="UseWorkerDemo"><span>Worker</span><b>Fill details</b></button>
                    </div>
                }
                else
                {
                    <ol class="signup-steps"><li>Get your Employee ID from the admin.</li><li>Submit this form and wait for account approval.</li><li>Ask the admin to start fingerprint enrollment, then scan twice when the device prompts you.</li></ol>
                    <form class="login-form signup-form" @onsubmit="SignupAsync" @onsubmit:preventDefault="true">
                        <label for="signup-employee-id">Employee ID</label>
                        <input id="signup-employee-id" autocomplete="off" @bind="signupEmployeeId" placeholder="e.g. EMP-001" required maxlength="30" />
                        <label for="signup-username">Choose a username</label>
                        <input id="signup-username" autocomplete="username" @bind="signupUsername" placeholder="3–60 letters, numbers, . _ or -" required minlength="3" maxlength="60" />
                        <label for="signup-password">Password</label>
                        <input id="signup-password" type="password" autocomplete="new-password" @bind="signupPassword" placeholder="At least 10 characters" required minlength="10" maxlength="72" />
                        <label for="signup-confirm">Confirm password</label>
                        <input id="signup-confirm" type="password" autocomplete="new-password" @bind="signupConfirmPassword" placeholder="Enter the password again" required minlength="10" maxlength="72" />
                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert error" role="alert">@errorMessage</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(signupMessage))
                        {
                            <div class="alert success" role="status">@signupMessage</div>
                        }
                        <button class="button primary full" type="submit" disabled="@busy">@(busy ? "Submitting…" : "Request worker account") <span aria-hidden="true">→</span></button>
                    </form>
                    <button class="auth-switch" type="button" @onclick="ShowLogin">Already registered? <strong>Sign in</strong></button>
                }
                <p class="secure-note"><span>●</span> Connected to this website's attendance server</p>
            </div>
        </section>
    </main>
}
else if (isWorker)
{
    <div class="portal-shell">
        <header class="portal-header"><a class="wordmark" href="/"><span class="brand-mark small">M</span><span>MECKY'S<small>ATTENDANCE PORTAL</small></span></a><div class="header-user"><span class="avatar">@Initials(worker?.fullName)</span><span class="user-name">@worker?.fullName<small>Worker account</small></span><button class="button outline" @onclick="SignOut">Sign out</button></div></header>
        <main class="portal-main">
            <div class="page-heading"><div><p class="eyebrow green">MY WORKSPACE</p><h1>My attendance</h1><p class="muted">Review your scans and workdays for up to five days.</p></div><button class="button outline" @onclick="LoadWorkerAttendanceAsync" disabled="@busy">↻ &nbsp;Refresh status</button></div>
            @if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="alert error" role="alert">@errorMessage</div> }
            <section class="welcome-strip"><div class="welcome-icon">@Initials(worker?.fullName)</div><div><span class="muted">SIGNED IN AS</span><h2>@(worker?.fullName ?? username)</h2><p>@(worker?.position ?? "Employee") <span class="dot-separator">•</span> ID @worker?.employeeId</p></div><div class="live-pill"><span></span> Connected</div></section>
            <section class="panel range-panel"><div><h2>Choose the days to view</h2><p class="muted">You can check a range of one to five calendar days.</p></div><div class="range-controls"><label>From<input type="date" @bind="fromDate" /></label><span class="range-dash">—</span><label>To<input type="date" @bind="toDate" /></label><button class="button primary" @onclick="LoadWorkerAttendanceAsync" disabled="@busy">Show days</button></div></section>
            @if (workerAttendance is not null)
            {
                <section class="stat-grid worker-stats"><article class="stat-card"><span>Days worked</span><strong>@workerAttendance.daysWorked</strong><small>Days with a time-in scan</small></article><article class="stat-card"><span>Days absent</span><strong>@workerAttendance.daysAbsent</strong><small>Recorded absence</small></article><article class="stat-card"><span>Days in range</span><strong>@workerAttendance.days.Count</strong><small>@ShortDate(workerAttendance.from) – @ShortDate(workerAttendance.to)</small></article></section>
                <section class="panel table-panel"><div class="panel-heading"><div><h2>Daily status</h2><p class="muted">Most recent refresh: @lastUpdated</p></div><span class="record-count">@workerAttendance.days.Count DAYS</span></div><div class="table-scroll"><table><thead><tr><th>Day</th><th>Schedule</th><th>Time in</th><th>Time out</th><th>Status</th><th>Hours</th></tr></thead><tbody>
                    @foreach (var day in workerAttendance.days)
                    {
                        <tr><td><strong>@ShortDate(day.date)</strong><small>@Weekday(day.date)</small></td><td>@(day.scheduled ? "Scheduled" : "Off day")</td><td>@FormatMoment(day.timeIn)</td><td>@FormatMoment(day.timeOut)</td><td><span class="status @StatusClass(day.status)">@PrettyStatus(day.status)</span></td><td>@day.hoursWorked.ToString("0.00")</td></tr>
                    }
                </tbody></table></div></section>
            }
            <p class="footnote">Attendance is updated when a scan reaches the company's system. Select <strong>Refresh status</strong> to check for the latest scan.</p>
        </main>
    </div>
}
else
{
    <div class="admin-shell">
        <aside class="sidebar"><a class="wordmark side-wordmark" href="/"><span class="brand-mark">M</span><span>MECKY'S<small>CEO / ADMIN</small></span></a><div class="side-label">WORKSPACE</div><nav>
            <button class="side-link @(activeView == "Dashboard" ? "active" : "")" @onclick='() => SelectView("Dashboard")'><span>◫</span>Dashboard</button>
            <button class="side-link @(activeView == "Employees" ? "active" : "")" @onclick="OpenEmployeesAsync"><span>♙</span>Employees</button>
            <button class="side-link @(activeView == "Attendance" ? "active" : "")" @onclick="OpenAttendanceAsync"><span>◷</span>Attendance</button>
            <button class="side-link @(activeView == "Payroll" ? "active" : "")" @onclick="OpenPayrollAsync"><span>₱</span>Payroll</button>
            <button class="side-link @(activeView == "User Access" ? "active" : "")" @onclick="OpenUserAccessAsync"><span>♙</span>Account approvals</button>
        </nav><div class="sidebar-bottom"><div class="sidebar-user"><span class="avatar">AD</span><span>@username<small>Administrator</small></span></div><button class="side-link signout" @onclick="SignOut"><span>↪</span>Sign out</button></div></aside>
        <main class="admin-main">
            <header class="admin-topbar"><div class="breadcrumb">MECKY'S <span>/</span> @(activeView.ToUpperInvariant())</div><div class="top-user"><span class="live-pill"><span></span> Server connected</span><span class="avatar">AD</span></div></header>
            <div class="admin-content">
                @if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="alert error" role="alert">@errorMessage</div> }
                @if (activeView == "Dashboard")
                {
                    <div class="page-heading"><div><p class="eyebrow green">OVERVIEW</p><h1>Dashboard</h1><p class="muted">Attendance summary for @ShortDate(dashboard?.date ?? today).</p></div><button class="button outline" @onclick="LoadAdminAsync" disabled="@busy">↻ &nbsp;Refresh</button></div>
                    <section class="stat-grid"><article class="stat-card"><span>Active employees</span><strong>@(dashboard?.employees ?? 0)</strong><small>Employee records</small></article><article class="stat-card"><span>Present today</span><strong>@(dashboard?.present ?? 0)</strong><small>Time-in recorded</small></article><article class="stat-card"><span>Absent today</span><strong>@(dashboard?.absent ?? 0)</strong><small>Based on active employees</small></article><article class="stat-card"><span>Late today</span><strong>@(dashboard?.late ?? 0)</strong><small>Late arrivals</small></article></section>
                    <section class="panel table-panel"><div class="panel-heading"><div><h2>Latest attendance</h2><p class="muted">Today's latest employee scans</p></div><button class="text-button" @onclick="OpenAttendanceAsync">View attendance →</button></div>@AttendanceTable(dashboard?.latest ?? new List<AttendanceRecord>())</section>
                    <section class="notice-card"><span class="notice-icon">@(connectedDevice is null ? "…" : connectedDevice.status == "ONLINE" ? "✓" : "!")</span><div><strong>Fingerprint device: @(connectedDevice?.status ?? "Not seen yet")</strong><p>@(connectedDevice?.lastSeen is { Length: > 0 } seen ? $"Last heartbeat: {FormatMoment(seen)}" : "Connect the ESP32 and check its Render API key; the device status updates on its heartbeat.") Payroll demo is available from the left menu.</p></div></section>
                }
                else if (activeView == "Employees")
                {
                    <div class="page-heading">
                        <div><p class="eyebrow green">PEOPLE</p><h1>Employees</h1><p class="muted">Manage employee records and fingerprint enrollment.</p></div>
                        <div class="employee-actions">
                            <button class="button outline" @onclick="LoadEmployeesAsync" disabled="@busy">Refresh</button>
                            <button class="button outline" @onclick="OpenUserAccessAsync">Account approvals</button>
                            <button class="button primary" @onclick="OpenEmployeeForm" disabled="@busy">Add employee</button>
                        </div>
                    </div>
                    @if (employeeNotice.Length > 0)
                    {
                        <div class="alert success" role="status">@employeeNotice</div>
                    }
                    @if (employeeToDeactivate is { } selectedEmployee)
                    {
                        <section class="panel employee-editor deactivate-confirm" aria-labelledby="deactivate-title">
                            <h2 id="deactivate-title">Deactivate @selectedEmployee.fullName?</h2>
                            <p class="muted">This removes the employee from the active list and preserves their attendance history.</p>
                            <div class="employee-actions">
                                <button class="button danger" @onclick="DeactivateEmployeeAsync" disabled="@busy">Confirm deactivation</button>
                                <button class="button outline" @onclick="CancelDeactivation" disabled="@busy">Cancel</button>
                            </div>
                        </section>
                    }
                    @if (showEmployeeForm)
                    {
                        <section class="panel employee-editor" aria-labelledby="employee-form-title">
                            <h2 id="employee-form-title">Add an employee</h2>
                            <p class="muted">Share this Employee ID with the worker after saving.</p>
                            <form class="employee-fields" @onsubmit="CreateEmployeeAsync" @onsubmit:preventDefault="true">
                                <label>Employee ID<input @bind="newEmployeeId" placeholder="EMP-005" required maxlength="30" /></label>
                                <label>Full name<input @bind="newEmployeeName" required maxlength="120" /></label>
                                <label>Position<input @bind="newEmployeePosition" maxlength="80" /></label>
                                <label>Daily rate (PHP)<input type="number" min="0" max="99999999.99" step="0.01" @bind="newEmployeeRate" required /></label>
                                <div class="employee-actions">
                                    <button class="button primary" type="submit" disabled="@busy">Save employee</button>
                                    <button class="button outline" type="button" @onclick="CloseEmployeeForm" disabled="@busy">Cancel</button>
                                </div>
                            </form>
                        </section>
                    }
                    <section class="panel table-panel"><div class="panel-heading"><div><h2>Active employees</h2><p class="muted">Start fingerprint enrollment here; the employee then scans twice at the connected ESP32.</p></div><span class="record-count">@employees.Count EMPLOYEES</span></div><div class="table-scroll"><table class="employees-table"><thead><tr><th>Employee</th><th>Employee ID</th><th>Position</th><th>Fingerprint slot</th><th>Daily rate</th><th>Device enrollment</th><th>Manage</th></tr></thead><tbody>@if (employees.Count == 0) { <tr><td colspan="7" class="empty-cell">No active employees. Select Add employee to get started.</td></tr> } @foreach (var employee in employees) { <tr><td><div class="employee-name"><span class="employee-initials" aria-hidden="true">@Initials(employee.fullName)</span><strong>@employee.fullName</strong></div></td><td><span class="employee-id">@employee.employeeId</span></td><td>@(string.IsNullOrWhiteSpace(employee.position) ? "—" : employee.position)</td><td>@(employee.sensorSlotId?.ToString() ?? "Not enrolled")</td><td>@Money(employee.dailyRate)</td><td><div class="enroll-actions"><button class="text-button" @onclick="() => StartEnrollmentAsync(employee)" disabled="@busy">Start enrollment</button><button class="text-button" @onclick="() => CheckEnrollmentAsync(employee)" disabled="@busy">Check status</button></div>@if (enrollmentMessages.TryGetValue(employee.employeeId, out var message)) { <small class="enrollment-note">@message</small> }</td><td><button class="text-button danger-text" @onclick="() => AskDeactivate(employee)" disabled="@busy">Deactivate</button></td></tr> }</tbody></table></div></section>
                }
                else if (activeView == "Payroll")
                {
                    <div class="page-heading"><div><p class="eyebrow green">PAY PERIOD</p><h1>Payroll</h1><p class="muted">Calculate pay from fingerprint attendance for the selected dates.</p></div><div class="date-toolbar payroll-toolbar"><label>From<input type="date" @bind="payrollFrom" /></label><label>To<input type="date" @bind="payrollTo" /></label><button class="button primary" @onclick="CalculatePayrollAsync" disabled="@busy">Calculate</button></div></div>
                    <section class="notice-card payroll-note"><span class="notice-icon">₱</span><div><strong>Demo payroll calculation</strong><p>Gross pay = days with a time-in scan × daily rate. Demo deductions are ₱0; tax, SSS, PhilHealth, Pag-IBIG, overtime, and undertime are not calculated.</p></div></section>
                    @if (payrollRows is not null)
                    {
                        <section class="stat-grid compact-stats payroll-stats"><article class="stat-card"><span>Employees</span><strong>@payrollRows.Count</strong><small>Active employees in this run</small></article><article class="stat-card"><span>Gross pay</span><strong>@Money(payrollRows.Sum(x => x.grossPay))</strong><small>Before deductions</small></article><article class="stat-card"><span>Net demo pay</span><strong>@Money(payrollRows.Sum(x => x.netPay))</strong><small>Equal to gross in this demo</small></article></section>
                        <section class="panel table-panel"><div class="panel-heading"><div><h2>@(payrollSaved ? "Saved payroll run" : "Payroll preview")</h2><p class="muted">@ShortDate(payrollFrom) – @ShortDate(payrollTo) @(payrollSaved ? "• Saved; this period is locked" : "• Review the figures before saving")</p></div><div class="payroll-actions"><button class="button outline" @onclick="ExportPayrollAsync" disabled="@(payrollRows.Count == 0)">Export CSV</button><button class="button primary" @onclick="SavePayrollAsync" disabled="@(busy || payrollSaved || payrollRows.Count == 0)">@(payrollSaved ? "Run saved" : "Save payroll run")</button></div></div><div class="table-scroll"><table class="payroll-table"><thead><tr><th>Employee</th><th>Days present</th><th>Recorded absences</th><th>Late minutes</th><th>Daily rate</th><th>Gross pay</th><th>Deductions</th><th>Net demo pay</th>@if (!payrollSaved) { <th>Rate action</th> }</tr></thead><tbody>
                            @if (payrollRows.Count == 0) { <tr><td colspan="9" class="empty-cell">No active employees were found for this payroll run.</td></tr> }
                            @foreach (var row in payrollRows)
                            {
                                <tr><td><strong>@row.employeeName</strong><small>@row.employeeId</small></td><td>@row.daysPresent</td><td>@row.daysAbsent</td><td>@row.lateMinutes</td><td>@if (payrollSaved) { @Money(row.dailyRate) } else { <input aria-label="Daily rate for @row.employeeName" type="number" min="0" step="0.01" @bind="row.rateEdit" /> }</td><td><strong>@Money(row.grossPay)</strong></td><td>@Money(row.deductions)</td><td><strong>@Money(row.netPay)</strong></td>@if (!payrollSaved) { <td><button class="text-button" @onclick="() => SaveDailyRateAsync(row)" disabled="@busy">Save rate</button></td> }</tr>
                            }
                        </tbody><tfoot><tr><th colspan="5">TOTAL</th><th>@Money(payrollRows.Sum(x => x.grossPay))</th><th>@Money(payrollRows.Sum(x => x.deductions))</th><th>@Money(payrollRows.Sum(x => x.netPay))</th>@if (!payrollSaved) { <th></th> }</tr></tfoot></table></div></section>
                        <p class="footnote">Saved runs cannot be changed. Render's current demo uses an in-memory H2 database, so saved payroll and attendance are cleared when the service restarts.</p>
                    }
                    else
                    {
                        <section class="panel empty-payroll"><strong>Choose a date range, then select Calculate.</strong><p class="muted">Payroll uses the attendance records and daily rates currently stored in the server.</p></section>
                    }
                }
                else if (activeView == "User Access")
                {
                    <div class="page-heading"><div><p class="eyebrow green">ACCOUNT APPROVAL</p><h1>Account approvals</h1><p class="muted">Approve new worker signups so employees can sign in.</p></div><button class="button outline" @onclick="LoadUsersAsync" disabled="@busy">↻ &nbsp;Refresh</button></div>
                    @if (!users.Any(x => x.role == "EMPLOYEE" && !x.active))
                    {
                        <p class="approval-note">No pending requests. New worker signups will appear here.</p>
                    }
                    <section class="panel table-panel"><div class="panel-heading"><div><h2>Worker accounts</h2><p class="muted">Only active employee records can request an account. Admin accounts cannot be created here.</p></div><span class="record-count">@users.Count(x => x.role == "EMPLOYEE" && !x.active) PENDING</span></div><div class="table-scroll"><table><thead><tr><th>Username</th><th>Employee ID</th><th>Role</th><th>Access status</th><th>Action</th></tr></thead><tbody>
                        @if (!users.Any(x => x.role == "EMPLOYEE")) { <tr><td colspan="5" class="empty-cell">No worker accounts yet. Requests appear here after a worker signs up.</td></tr> }
                        @foreach (var account in users.Where(x => x.role == "EMPLOYEE").OrderBy(x => x.active).ThenBy(x => x.username))
                        {
                            <tr><td><strong>@account.username</strong></td><td>@(account.employeeId ?? "—")</td><td>Worker</td><td><span class="status @(account.active ? "good" : "warning")">@(account.active ? "Approved" : "Pending approval")</span></td><td>@if (!account.active) { <button class="button primary approve-button" @onclick="() => ApproveUserAsync(account)" disabled="@busy">Approve account</button> } else { <span class="muted">—</span> }</td></tr>
                        }
                        </tbody></table></div></section>
                }
                else
                {
                    <div class="page-heading"><div><p class="eyebrow green">DAILY RECORDS</p><h1>Attendance</h1><p class="muted">Review fingerprint scans for a selected date.</p></div><div class="date-toolbar"><input type="date" @bind="attendanceDate" /><button class="button primary" @onclick="LoadAttendanceAsync" disabled="@busy">Show date</button></div></div>
                    <section class="stat-grid compact-stats"><article class="stat-card"><span>Records</span><strong>@attendanceRows.Count</strong></article><article class="stat-card"><span>Present</span><strong>@attendanceRows.Count(x => x.status == "PRESENT" || x.status == "TIME_OUT")</strong></article><article class="stat-card"><span>Late</span><strong>@attendanceRows.Count(x => x.status == "LATE" || x.lateMinutes > 0)</strong></article></section>
                    <section class="panel table-panel"><div class="panel-heading"><div><h2>Attendance records</h2><p class="muted">@ShortDate(attendanceDate)</p></div><span class="record-count">@attendanceRows.Count RECORDS</span></div>@AttendanceTable(attendanceRows)</section>
                }
                <p class="footnote">Mecky's attendance management <span>•</span> Signed in as @username</p>
            </div>
        </main>
    </div>
}

@code {
    private bool isSignedIn;
    private bool isWorker;
    private bool busy;
    private bool showSignup;
    private bool showEmployeeForm;
    private EmployeeRecord? employeeToDeactivate;
    private string newEmployeeId = "";
    private string newEmployeeName = "";
    private string newEmployeePosition = "";
    private decimal newEmployeeRate;
    private string employeeNotice = "";
    private string username = "";
    private string password = "";
    private string signupEmployeeId = "";
    private string signupUsername = "";
    private string signupPassword = "";
    private string signupConfirmPassword = "";
    private string signupMessage = "";
    private string errorMessage = "";
    private string activeView = "Dashboard";
    private string today = DateTime.Now.ToString("yyyy-MM-dd");
    private DateTime fromDate = DateTime.Today.AddDays(-4);
    private DateTime toDate = DateTime.Today;
    private DateTime attendanceDate = DateTime.Today;
    private DateTime payrollFrom = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime payrollTo = DateTime.Today;
    private string lastUpdated = "—";
    private DashboardSummary? dashboard;
    private List<EmployeeRecord> employees = new();
    private List<UserAccountRecord> users = new();
    private List<AttendanceRecord> attendanceRows = new();
    private WorkerProfile? worker;
    private WorkerAttendance? workerAttendance;
    private List<PayrollRow>? payrollRows;
    private bool payrollSaved;
    private Dictionary<string, string> enrollmentMessages = new();
    private DeviceStatusRecord? connectedDevice;

    private void ShowSignup() { showSignup = true; errorMessage = ""; signupMessage = ""; }
    private void ShowLogin() { showSignup = false; errorMessage = ""; signupMessage = ""; }
    private void UseAdminDemo() { username = "admin"; password = "DemoAdmin2026!"; errorMessage = ""; }
    private void UseWorkerDemo() { username = "demo-worker-one"; password = "DemoWorker2026!"; errorMessage = ""; }

    private async Task SignupAsync()
    {
        if (busy) return;
        busy = true;
        errorMessage = "";
        signupMessage = "";
        try
        {
            using var response = await Http.PostAsJsonAsync("api/auth/signup", new
            {
                employeeId = signupEmployeeId.Trim(),
                username = signupUsername.Trim(),
                password = signupPassword,
                confirmPassword = signupConfirmPassword
            });
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ReadServerErrorAsync(response);
                return;
            }
            var result = await response.Content.ReadFromJsonAsync<SignupResult>();
            signupMessage = result?.message ?? "Signup received. Ask the Admin to approve your account before signing in.";
            signupEmployeeId = "";
            signupUsername = "";
            signupPassword = "";
            signupConfirmPassword = "";
        }
        catch (HttpRequestException)
        {
            errorMessage = "The attendance server did not respond. Wait a moment and submit again.";
        }
        catch (Exception)
        {
            errorMessage = "Signup could not be submitted. Check the details and try again.";
        }
        finally { busy = false; }
    }

    private async Task LoginAsync()
    {
        if (busy) return;
        busy = true;
        errorMessage = "";
        try
        {
            using var response = await Http.PostAsJsonAsync("api/auth/login", new { username, password });
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await ReadServerErrorAsync(response);
                return;
            }
            var result = await response.Content.ReadFromJsonAsync<LoginResult>();
            if (result is null || string.IsNullOrWhiteSpace(result.token))
            {
                errorMessage = "The server did not return a sign-in token. Please try again.";
                return;
            }
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", result.token);
            isWorker = string.Equals(result.role, "EMPLOYEE", StringComparison.OrdinalIgnoreCase);
            if (!isWorker && !string.Equals(result.role, "ADMIN", StringComparison.OrdinalIgnoreCase))
            {
                Http.DefaultRequestHeaders.Authorization = null;
                errorMessage = "This account does not have access to the attendance portal.";
                return;
            }
            isSignedIn = true;
            if (isWorker) await LoadWorkerAsync();
            else await LoadAdminAsync();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The attendance server did not respond. Wait a moment and try again; the free Render service may be waking up.";
        }
        catch (Exception)
        {
            errorMessage = "Could not sign in. Please check your details and try again.";
        }
        finally { busy = false; }
    }

    private async Task LoadAdminAsync()
    {
        errorMessage = "";
        try
        {
            dashboard = await Http.GetFromJsonAsync<DashboardSummary>("api/dashboard");
            await LoadEmployeesAsync();
            if (dashboard is not null) attendanceRows = dashboard.latest;
            try
            {
                var deviceRows = await Http.GetFromJsonAsync<List<DeviceStatusRecord>>("api/device/status") ?? new();
                connectedDevice = deviceRows.FirstOrDefault(x => x.status == "ONLINE") ?? deviceRows.FirstOrDefault();
            }
            catch (HttpRequestException) { connectedDevice = null; }
        }
        catch (HttpRequestException) { errorMessage = "We could not load the admin dashboard. Refresh the page data or sign in again."; }
    }

