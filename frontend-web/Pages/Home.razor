    private async Task OpenPayrollAsync()
    {
        activeView = "Payroll";
        payrollRows = null;
        await CalculatePayrollAsync();
    }

    private async Task CalculatePayrollAsync()
    {
        errorMessage = "";
        if (payrollTo.Date < payrollFrom.Date)
        {
            errorMessage = "The end date must be on or after the start date.";
            return;
        }
        busy = true;
        try
        {
            var preview = await Http.GetFromJsonAsync<List<PayrollRow>>($"api/reports/payroll?from={payrollFrom:yyyy-MM-dd}&to={payrollTo:yyyy-MM-dd}") ?? new();
            var saved = await Http.GetFromJsonAsync<PayrollRunResponse>($"api/payroll/run?from={payrollFrom:yyyy-MM-dd}&to={payrollTo:yyyy-MM-dd}");
            payrollSaved = saved?.saved == true;
            payrollRows = payrollSaved ? (saved?.rows ?? new()) : preview;
            foreach (var row in payrollRows) row.rateEdit = row.dailyRate;
        }
        catch (HttpRequestException) { errorMessage = "Payroll could not be loaded. Wait for Render to wake, then calculate again."; }
        finally { busy = false; }
    }

    private async Task SavePayrollAsync()
    {
        if (payrollRows is null || payrollRows.Count == 0 || busy) return;
        busy = true;
        errorMessage = "";
        try
        {
            using var response = await Http.PostAsJsonAsync("api/payroll/run", new PayrollPeriodRequest { from = payrollFrom.ToString("yyyy-MM-dd"), to = payrollTo.ToString("yyyy-MM-dd") });
            if (!response.IsSuccessStatusCode) { errorMessage = await ReadServerErrorAsync(response); return; }
            var saved = await response.Content.ReadFromJsonAsync<PayrollRunResponse>();
            if (saved is null) { errorMessage = "The server did not return the saved payroll run."; return; }
            payrollRows = saved.rows;
            payrollSaved = saved.saved;
        }
        catch (HttpRequestException) { errorMessage = "The payroll run could not be saved. Check the connection and retry."; }
        finally { busy = false; }
    }

    private async Task SaveDailyRateAsync(PayrollRow row)
    {
        var employee = employees.FirstOrDefault(x => x.employeeId == row.employeeId);
        if (employee is null || row.rateEdit < 0 || busy) { errorMessage = "Enter a valid non-negative daily rate."; return; }
        busy = true;
        errorMessage = "";
        try
        {
            using var response = await Http.PutAsJsonAsync($"api/employees/{Uri.EscapeDataString(employee.employeeId)}", new
            {
                employee.employeeId, employee.fullName, employee.position, employee.contactNumber, employee.address,
                dailyRate = row.rateEdit
            });
            if (!response.IsSuccessStatusCode) { errorMessage = await ReadServerErrorAsync(response); return; }
            employee.dailyRate = row.rateEdit;
            await CalculatePayrollAsync();
        }
        catch (HttpRequestException) { errorMessage = "The daily rate could not be saved."; }
        finally { busy = false; }
    }

    private async Task ExportPayrollAsync()
    {
        if (payrollRows is null || payrollRows.Count == 0) return;
        var csv = new System.Text.StringBuilder("Employee ID,Employee,Days Present,Recorded Absences,Late Minutes,Daily Rate,Gross Pay,Deductions,Net Demo Pay\r\n");
        foreach (var row in payrollRows)
            csv.AppendJoin(',', Csv(row.employeeId), Csv(row.employeeName), row.daysPresent, row.daysAbsent, row.lateMinutes,
                row.dailyRate.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture), row.grossPay.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture), row.deductions.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture), row.netPay.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)).Append("\r\n");
        await JS.InvokeVoidAsync("mecky.downloadText", $"payroll-{payrollFrom:yyyyMMdd}-{payrollTo:yyyyMMdd}.csv", csv.ToString(), "text/csv;charset=utf-8");
    }

    private static string Csv(string value) => "\"" + (value ?? "").Replace("\"", "\"\"") + "\"";
    private static string Money(decimal value) => "₱" + value.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-PH"));

