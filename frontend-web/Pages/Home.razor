    private async Task StartEnrollmentAsync(EmployeeRecord employee)
    {
        if (busy) return;
        busy = true;
        errorMessage = "";
        try
        {
            using var response = await Http.PostAsync($"api/employees/{Uri.EscapeDataString(employee.employeeId)}/enroll", null);
            if (!response.IsSuccessStatusCode) { errorMessage = await ReadServerErrorAsync(response); return; }
            enrollmentMessages[employee.employeeId] = "Queued. Keep device online; scan this employee's finger twice.";
        }
        catch (HttpRequestException) { errorMessage = "Could not send enrollment to the device. Check the API connection."; }
        finally { busy = false; }
    }

    private async Task CheckEnrollmentAsync(EmployeeRecord employee)
    {
        if (busy) return;
        busy = true;
        errorMessage = "";
        try
        {
            var command = await Http.GetFromJsonAsync<EnrollmentCommand>($"api/employees/{Uri.EscapeDataString(employee.employeeId)}/enrollment-status");
            await LoadEmployeesAsync();
            var refreshedEmployee = employees.FirstOrDefault(x => x.employeeId == employee.employeeId) ?? employee;
            enrollmentMessages[employee.employeeId] = command?.status switch
            {
                "PENDING" => "Waiting for ESP32. Check device Wi-Fi and API key.",
                "SENT" => "Device received command. Scan the same finger twice now.",
                "SUCCESS" => $"Enrolled successfully in fingerprint slot {refreshedEmployee.sensorSlotId}.",
                "FAILED" => command.resultMessage ?? "Enrollment failed. Start again.",
                _ => "No enrollment command is available. Start enrollment first."
            };
        }
        catch (HttpRequestException) { enrollmentMessages[employee.employeeId] = "No status yet. Start enrollment and check the device connection."; }
        finally { busy = false; }
    }

