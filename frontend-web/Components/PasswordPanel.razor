@using System.Text.Json.Nodes
@inject HttpClient Http

<div class="password-overlay">
    <section class="password-panel panel" role="dialog" aria-modal="true" aria-labelledby="password-panel-title">
        <p class="eyebrow green">ACCOUNT SECURITY</p>
        <h2 id="password-panel-title">@(ResetUserId.HasValue ? "Reset worker password" : "Change your password")</h2>
        <p class="muted">@(ResetUserId.HasValue ? $"Set a new password for {AccountName}. The worker will need to sign in again." : "Use your current password to confirm this change. You will sign in again with your new password.")</p>
        <form class="login-form" @onsubmit="SaveAsync" @onsubmit:preventDefault="true" aria-busy="@saving">
            <label for="account-current-password">@(ResetUserId.HasValue ? "Your admin password" : "Current password")</label>
            <input id="account-current-password" type="password" autocomplete="current-password" @bind="currentPassword" @bind:event="oninput" maxlength="200" required autofocus disabled="@saving" />
            <label for="account-new-password">New password</label>
            <input id="account-new-password" type="password" autocomplete="new-password" @bind="newPassword" @bind:event="oninput" minlength="10" maxlength="72" required disabled="@saving" />
            <small class="password-hint">Use 10–72 characters. Choose a password you have not used for this account.</small>
            <label for="account-confirm-password">Confirm new password</label>
            <input id="account-confirm-password" type="password" autocomplete="new-password" @bind="confirmPassword" @bind:event="oninput" minlength="10" maxlength="72" required disabled="@saving" />
            @if (error.Length > 0) { <div class="alert error" role="alert">@error</div> }
            <div class="password-actions">
                <button class="button outline" type="button" @onclick="CancelAsync" disabled="@saving">Cancel</button>
                <button class="button primary" type="submit" disabled="@saving">@(saving ? "Saving…" : ResetUserId.HasValue ? "Reset password" : "Update password")</button>
            </div>
        </form>
    </section>
</div>

@code {
    [Parameter] public long? ResetUserId { get; set; }
    [Parameter] public string AccountName { get; set; } = "";
    [Parameter] public EventCallback<string> OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string error = "";
    private bool saving;

    private async Task SaveAsync()
    {
        if (saving) return;
        error = "";
        if (newPassword != confirmPassword) { error = "The new passwords do not match."; return; }
        if (System.Text.Encoding.UTF8.GetByteCount(newPassword) > 72)
        {
            error = "Use a password of at most 72 UTF-8 bytes. Some symbols use more than one byte.";
            return;
        }
        saving = true;
        try
        {
            var payload = new JsonObject
            {
                ["currentPassword"] = currentPassword,
                ["newPassword"] = newPassword,
                ["confirmPassword"] = confirmPassword
            };
            using var body = new StringContent(payload.ToJsonString(), System.Text.Encoding.UTF8, "application/json");
            string path = ResetUserId.HasValue ? $"api/users/{ResetUserId.Value}/reset-password" : "api/auth/change-password";
            using var response = await Http.PostAsync(path, body);
            string text = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode)
            {
                error = response.StatusCode == System.Net.HttpStatusCode.Forbidden
                    ? "Your session expired. Close this form and sign in again."
                    : "The password could not be updated. Please try again.";
                try
                {
                    using var result = System.Text.Json.JsonDocument.Parse(text);
                    if (result.RootElement.TryGetProperty("error", out var message)) error = message.GetString() ?? error;
                }
                catch (System.Text.Json.JsonException) { }
                return;
            }
            currentPassword = newPassword = confirmPassword = "";
            using var saved = System.Text.Json.JsonDocument.Parse(text);
            string notice = saved.RootElement.GetProperty("message").GetString() ?? "Password updated.";
            await OnSaved.InvokeAsync(notice);
        }
        catch (HttpRequestException) { error = "The server did not respond. Try signing in with your new password to check whether the change was saved."; }
        catch (TaskCanceledException) { error = "The request timed out. Try signing in with your new password to check whether the change was saved."; }
        catch (System.Text.Json.JsonException) { error = "The server response could not be read. Try signing in with your new password to check the result."; }
        finally { saving = false; }
    }

    private async Task CancelAsync()
    {
        currentPassword = newPassword = confirmPassword = "";
        await OnCancel.InvokeAsync();
    }
}
